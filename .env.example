# Core app settings
PORT=3000
NODE_ENV=production

# Optional: higher GitHub API rate limits and richer showcase metadata.
# Not required for the site to boot; public GitHub data may still work with limits.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Check Point Infinity Next Nano (OPTIONAL / FUTURE — not used in live stack)
# Live deployment is app-only on Dokploy; NANO_* are not required today.
# Uncomment / set only if you later enable the optional waf/ Nano integration.
# ---------------------------------------------------------------------------
# NANO_TENANT_ID=
# NANO_PROFILE_TOKEN=
# NANO_SERVICE_NAME=bryansmith-tech
# NANO_MODE=protect

# Public site origin used for Open Graph absolute URLs
SITE_URL=https://bryansmith.tech

# Plausible Analytics (optional). If unset, no tracking script is injected.
# Create the site in the Plausible dashboard, then set this on Dokploy.
PLAUSIBLE_DOMAIN=bryansmith.tech
